      "converter_flux_decomposition",
      "converter_flue_gas_cleaning",
      "secondary_metallurgy_and_vacuum_degassing",
      "continuous_casting",
      "primary_hot_rolling_slot"
    ],
    "on_missing": "refuse import and name the missing sub_role_id",
    "note": "the list is the ST-06 process enumeration of the crude steel system boundary plus the three slots that exist to keep an unauthored activity visible; a slot with no exchange is a registered gap, never a silent absence"
  },
  "coverage_no_double_count": [
    {
      "topic": "burden carbon that leaves with the furnace gas",
      "rule": "counted once, as the two furnace CO2 exchanges, never also at the coke or coal input ports",
      "clause_refs": [
        "ST-08",
        "ST-10"
      ],
      "validation": "a second fossil CO2 source whose carbon origin is the same coke or coal input must be rejected by the coverage report"
    },
    {
      "topic": "sintered ore and hot metal inside one production process boundary",
      "rule": "their direct emissions enter the numerator at the process that produces them; they are not also charged as precursors of the slab",
      "clause_refs": [
        "ST-15",
        "ST-17"
      ]
    },
    {
      "topic": "grid electricity",
      "rule": "present as an activity for MFA and for the PCF question, excluded from the CBAM numerator with clause basis, because Annex II lists crude steel as a direct-emissions-only good",
      "clause_refs": [
        "ST-12"
      ]
    },
    {
      "topic": "continuous casting crop",
      "rule": "leaves the boundary as an output for the mass account but carries zero embedded emissions and never enters the activity level",
      "clause_refs": [
        "ST-16"
      ]
    }
  ]

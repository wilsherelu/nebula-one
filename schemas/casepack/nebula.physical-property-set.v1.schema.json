{
  "$defs": {
    "ExactFlowIdentity": {
      "additionalProperties": false,
      "properties": {
        "flow_content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Flow Content Sha256",
          "type": "string"
        },
        "flow_snapshot_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Flow Snapshot Sha256",
          "type": "string"
        },
        "flow_uuid": {
          "format": "uuid",
          "title": "Flow Uuid",
          "type": "string"
        },
        "source_namespace": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Source Namespace",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "source_namespace",
        "flow_uuid",
        "version",
        "flow_content_sha256",
        "flow_snapshot_sha256"
      ],
      "title": "ExactFlowIdentity",
      "type": "object"
    },
    "PhysicalPropertyBasis": {
      "additionalProperties": false,
      "properties": {
        "energy_convention": {
          "enum": [
            "lower_heating_value",
            "higher_heating_value",
            "not_applicable"
          ],
          "title": "Energy Convention",
          "type": "string"
        },
        "material_condition": {
          "enum": [
            "as_received",
            "dry",
            "dry_ash_free",
            "not_applicable"
          ],
          "title": "Material Condition",
          "type": "string"
        },
        "reference_pressure_pa": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Pressure Pa"
        },
        "reference_temperature_k": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Temperature K"
        }
      },
      "required": [
        "material_condition",
        "energy_convention"
      ],
      "title": "PhysicalPropertyBasis",
      "type": "object"
    },
    "PhysicalPropertyEvidenceReceipt": {
      "additionalProperties": false,
      "properties": {
        "citation": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license": {
          "maxLength": 255,
          "minLength": 1,
          "title": "License",
          "type": "string"
        },
        "receipt_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Receipt Sha256",
          "type": "string"
        },
        "review_status": {
          "enum": [
            "software_verification_only",
            "reviewed",
            "approved"
          ],
          "title": "Review Status",
          "type": "string"
        },
        "source_content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Content Sha256",
          "type": "string"
        },
        "source_hash_method": {
          "const": "canonical_json_sha256",
          "enum": [
            "canonical_json_sha256"
          ],
          "title": "Source Hash Method",
          "type": "string"
        },
        "source_kind": {
          "enum": [
            "published_source",
            "measured_source",
            "demonstration_authored"
          ],
          "title": "Source Kind",
          "type": "string"
        },
        "source_namespace": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Source Namespace",
          "type": "string"
        },
        "source_record_id": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Source Record Id",
          "type": "string"
        },
        "source_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Source Version",
          "type": "string"
        }
      },
      "required": [
        "source_namespace",
        "source_record_id",
        "source_version",
        "source_kind",
        "citation",
        "license",
        "source_hash_method",
        "source_content_sha256",
        "review_status",
        "receipt_sha256"
      ],
      "title": "PhysicalPropertyEvidenceReceipt",
      "type": "object"
    },
    "PhysicalPropertyRecord": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "$ref": "nebula.physical-property-set.v1.schema.json#/$defs/PhysicalPropertyBasis"
        },
        "evidence": {
          "$ref": "nebula.physical-property-set.v1.schema.json#/$defs/PhysicalPropertyEvidenceReceipt"
        },
        "geography": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Geography",
          "type": "string"
        },
        "property_code": {
          "enum": [
            "lower_heating_value",
            "higher_heating_value",
            "density",
            "moisture_content",
            "dry_matter_fraction",
            "carbon_content",
            "sulfur_content",
            "recoverable_fraction",
            "specific_enthalpy"
          ],
          "title": "Property Code",
          "type": "string"
        },
        "record_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Record Id",
          "type": "string"
        },
        "record_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Record Sha256",
          "type": "string"
        },
        "subject_flow": {
          "$ref": "nebula.physical-property-set.v1.schema.json#/$defs/ExactFlowIdentity"
        },
        "uncertainty": {
          "$ref": "nebula.physical-property-set.v1.schema.json#/$defs/PhysicalPropertyUncertainty"
        },
        "unit": {
          "$ref": "nebula.physical-property-set.v1.schema.json#/$defs/PhysicalUnitDefinition"
        },
        "usage_gate": {
          "enum": [
            "software_verification_only",
            "research",
            "approved"
          ],
          "title": "Usage Gate",
          "type": "string"
        },
        "valid_from": {
          "format": "date",
          "title": "Valid From",
          "type": "string"
        },
        "valid_to": {
          "format": "date",
          "title": "Valid To",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "record_id",
        "subject_flow",
        "property_code",
        "value",
        "unit",
        "basis",
        "geography",
        "valid_from",
        "valid_to",
        "evidence",
        "uncertainty",
        "usage_gate",
        "record_sha256"
      ],
      "title": "PhysicalPropertyRecord",
      "type": "object"
    },
    "PhysicalPropertySetIdentity": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "lifecycle_status": {
          "enum": [
            "draft",
            "frozen"
          ],
          "title": "Lifecycle Status",
          "type": "string"
        },
        "title": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "title",
        "lifecycle_status"
      ],
      "title": "PhysicalPropertySetIdentity",
      "type": "object"
    },
    "PhysicalPropertyUncertainty": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "none",
            "range",
            "standard_uncertainty"
          ],
          "title": "Kind",
          "type": "string"
        },
        "maximum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum"
        },
        "minimum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum"
        },
        "standard_uncertainty": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Standard Uncertainty"
        }
      },
      "required": [
        "kind"
      ],
      "title": "PhysicalPropertyUncertainty",
      "type": "object"
    },
    "PhysicalUnitDefinition": {
      "additionalProperties": false,
      "properties": {
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "quantity_dimension": {
          "enum": [
            "mass",
            "energy",
            "energy_per_mass",
            "mass_per_volume",
            "mass_fraction"
          ],
          "title": "Quantity Dimension",
          "type": "string"
        },
        "source_namespace": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Source Namespace",
          "type": "string"
        },
        "symbol": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Symbol",
          "type": "string"
        },
        "unit_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Unit Id",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "source_namespace",
        "unit_id",
        "version",
        "symbol",
        "quantity_dimension",
        "content_sha256"
      ],
      "title": "PhysicalUnitDefinition",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "case_pack_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Case Pack Id",
      "type": "string"
    },
    "content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "physical_property_set": {
      "$ref": "nebula.physical-property-set.v1.schema.json#/$defs/PhysicalPropertySetIdentity"
    },
    "records": {
      "items": {
        "$ref": "nebula.physical-property-set.v1.schema.json#/$defs/PhysicalPropertyRecord"
      },
      "minItems": 1,
      "title": "Records",
      "type": "array"
    },
    "schema_version": {
      "const": "nebula.physical-property-set.v1",
      "enum": [
        "nebula.physical-property-set.v1"
      ],
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "physical_property_set",
    "case_pack_id",
    "records",
    "content_sha256"
  ],
  "title": "PhysicalPropertySetDocument",
  "type": "object"
}

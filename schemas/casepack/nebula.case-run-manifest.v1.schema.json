{
  "$defs": {
    "CaseArtifactReceipt": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "CaseArtifactReceipt",
      "type": "object"
    },
    "CaseCapabilityRun": {
      "additionalProperties": false,
      "properties": {
        "audit_status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Audit Status"
        },
        "capability": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Capability",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "result_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result Sha256"
        },
        "status": {
          "enum": [
            "passed",
            "blocked",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "capability",
        "status"
      ],
      "title": "CaseCapabilityRun",
      "type": "object"
    },
    "CaseRunRevisionRef": {
      "additionalProperties": false,
      "properties": {
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "graph_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Graph Sha256",
          "type": "string"
        },
        "system_revision_id": {
          "maxLength": 255,
          "minLength": 1,
          "title": "System Revision Id",
          "type": "string"
        }
      },
      "required": [
        "system_revision_id",
        "content_sha256",
        "graph_sha256"
      ],
      "title": "CaseRunRevisionRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_receipts": {
      "items": {
        "$ref": "nebula.case-run-manifest.v1.schema.json#/$defs/CaseArtifactReceipt"
      },
      "minItems": 1,
      "title": "Artifact Receipts",
      "type": "array"
    },
    "capability_runs": {
      "items": {
        "$ref": "nebula.case-run-manifest.v1.schema.json#/$defs/CaseCapabilityRun"
      },
      "minItems": 1,
      "title": "Capability Runs",
      "type": "array"
    },
    "content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "declared_capabilities": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Declared Capabilities",
      "type": "array"
    },
    "demand_definition_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Demand Definition Sha256",
      "type": "string"
    },
    "resolved_case_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Resolved Case Sha256",
      "type": "string"
    },
    "revision_refs": {
      "items": {
        "$ref": "nebula.case-run-manifest.v1.schema.json#/$defs/CaseRunRevisionRef"
      },
      "minItems": 1,
      "title": "Revision Refs",
      "type": "array"
    },
    "run_id": {
      "maxLength": 255,
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "nebula.case-run-manifest.v1",
      "enum": [
        "nebula.case-run-manifest.v1"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "succeeded",
        "partial",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "study_frame_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Study Frame Sha256",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "status",
    "resolved_case_sha256",
    "study_frame_sha256",
    "demand_definition_sha256",
    "declared_capabilities",
    "revision_refs",
    "capability_runs",
    "artifact_receipts",
    "content_sha256"
  ],
  "title": "CaseRunManifest",
  "type": "object"
}
